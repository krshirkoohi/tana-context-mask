{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tana-context-mask",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-24",
  "compatibility_flags": ["nodejs_compat"],

  // D1 Database Binding for Graph + FTS5 metadata
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tana-db",
      "database_id": "6caa7980-719f-4d04-8a21-59fc13db5950"
    }
  ],

  // Vectorize Index Binding for 384-dim BGE embeddings
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "tana-nodes-index"
    }
  ],

  // Workers AI Binding for Edge Embeddings
  "ai": {
    "binding": "AI"
  },

  "workers_dev": true,

  // Automated background crons are disabled to prevent credit consumption.
  // Synchronization is performed on-demand via authenticated POST /api/v1/sync.
  "triggers": {
    "crons": []
  },

  "vars": {
    "ENVIRONMENT": "production"
  }
}
